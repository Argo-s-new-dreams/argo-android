[Unit]
Description=Argo Android: invio notturno al test interno di Google Play (se ci sono novità)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ANDROID_HOME=%h/android-sdk
Environment=JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Sviluppo/argo-android/strumenti/pubblica-se-serve.sh
